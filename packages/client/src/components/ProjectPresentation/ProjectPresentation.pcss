/* === Презентация: космический HUD / игровой интерфейс === */

.match3-presentation__dots {
  display: flex;
  justify-content: center;
  gap: 10px;
}

.match3-presentation__dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  padding: 0;
  background: rgba(15, 23, 42, 0.8);
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.match3-presentation__dot--active {
  background: #38bdf8;
  border-color: #7dd3fc;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.65);
  transform: scale(1.2);
}

.match3-presentation-fullscreen {
  --pres-accent: #38bdf8;
  --pres-accent-2: #a78bfa;
  --pres-panel: rgba(8, 16, 36, 0.82);
  --pres-border: rgba(56, 189, 248, 0.45);

  position: fixed;
  inset: 0;
  z-index: 1200;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  grid-template-rows: 1fr;
  align-items: stretch;
  gap: 12px;
  padding: 24px clamp(12px, 3vw, 40px);
  box-sizing: border-box;
  color: #e2e8f0;
  overflow: hidden;
  min-height: 100dvh;
  background-color: #020617;
  background-image:
    linear-gradient(
      165deg,
      rgba(8, 16, 36, 0.72) 0%,
      rgba(2, 6, 23, 0.82) 45%,
      rgba(15, 23, 42, 0.78) 100%
    ),
    var(--pres-bg-url, none);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.match3-presentation-fullscreen::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.35;
  background-image:
    radial-gradient(1px 1px at 10% 20%, rgba(255, 255, 255, 0.9), transparent),
    radial-gradient(1px 1px at 30% 65%, rgba(255, 255, 255, 0.7), transparent),
    radial-gradient(1.5px 1.5px at 55% 15%, rgba(125, 211, 252, 0.9), transparent),
    radial-gradient(1px 1px at 72% 42%, rgba(255, 255, 255, 0.65), transparent),
    radial-gradient(1px 1px at 88% 78%, rgba(255, 255, 255, 0.8), transparent),
    radial-gradient(1px 1px at 22% 88%, rgba(167, 139, 250, 0.75), transparent),
    radial-gradient(1px 1px at 48% 52%, rgba(255, 255, 255, 0.5), transparent);
  background-size: 100% 100%;
  animation: presentationStarsDrift 24s linear infinite;
}

.match3-presentation-fullscreen::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(56, 189, 248, 0.02) 2px,
    rgba(56, 189, 248, 0.02) 4px
  );
  opacity: 0.4;
}

@keyframes presentationStarsDrift {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-12px);
  }
}

.match3-presentation-fullscreen__topbar {
  --pres-topbar-control-height: 40px;
  position: absolute;
  top: 16px;
  left: clamp(12px, 3vw, 40px);
  right: clamp(12px, 3vw, 40px);
  z-index: 3;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px 12px;
  pointer-events: none;
}

.match3-presentation-fullscreen--compact-nav
  .match3-presentation-fullscreen__topbar {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
}

.match3-presentation-fullscreen__header-nav {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  gap: 8px;
  min-height: var(--pres-topbar-control-height);
  padding: 0;
}

.match3-presentation-fullscreen--compact-nav
  .match3-presentation-fullscreen__counter {
  grid-column: 1;
  justify-self: start;
}

.match3-presentation-fullscreen--compact-nav
  .match3-presentation-fullscreen__header-nav {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  transform: translateX(-50%);
  justify-self: auto;
}

.match3-presentation-fullscreen--compact-nav
  .match3-presentation-fullscreen__close {
  grid-column: 2;
  justify-self: end;
}

.match3-presentation-fullscreen__nav--header {
  width: 36px;
  height: 36px;
}

.match3-presentation-fullscreen__nav--inline {
  width: 40px;
  height: 40px;
}

.match3-presentation-fullscreen__dots--header {
  margin: 0;
  gap: 6px;
}

.match3-presentation-fullscreen__topbar > * {
  pointer-events: auto;
}

.match3-presentation-fullscreen__counter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  justify-self: start;
  margin: 0;
  padding: 8px 14px;
  min-height: var(--pres-topbar-control-height);
  border-radius: 10px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #e0f2fe;
  background: var(--pres-panel);
  border: 1px solid var(--pres-border);
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.12);
  width: fit-content;
  max-width: min(68vw, 520px);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match3-presentation-fullscreen__close {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: var(--pres-topbar-control-height);
  padding: 0 14px;
  border-radius: 10px;
  border: 1px solid var(--pres-border);
  background: var(--pres-panel);
  color: #e2e8f0;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.15);
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.match3-presentation-fullscreen__close-icon {
  display: none;
  font-size: 22px;
  line-height: 1;
  font-weight: 700;
  transform: rotate(45deg);
}

.match3-presentation-fullscreen__close:hover {
  border-color: #7dd3fc;
  box-shadow: 0 0 24px rgba(56, 189, 248, 0.35);
}

.match3-presentation-fullscreen__content {
  position: relative;
  z-index: 1;
  grid-column: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  max-width: min(980px, 100%);
  width: 100%;
  min-height: 0;
  height: 100%;
  margin: 0 auto;
  text-align: center;
  padding: 56px 8px 16px;
  box-sizing: border-box;
  overflow: hidden;
  touch-action: pan-y;
}

.match3-presentation-fullscreen__content-inner {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) 56px;
  align-items: stretch;
  width: 100%;
  min-height: 0;
  height: 100%;
  max-height: 100%;
  flex: 1 1 auto;
}

.match3-presentation-fullscreen__content:has(.presentation-slide--team),
.match3-presentation-fullscreen__content:has(.presentation-slide--title) {
  overflow: hidden;
  justify-content: stretch;
}

.match3-presentation-fullscreen__content:has(.presentation-slide--team)
  .match3-presentation-fullscreen__content-inner,
.match3-presentation-fullscreen__content:has(.presentation-slide--title)
  .match3-presentation-fullscreen__content-inner {
  height: 100%;
}

.match3-presentation-fullscreen__content:has(.presentation-slide--team)
  .match3-presentation-fullscreen__body,
.match3-presentation-fullscreen__content:has(.presentation-slide--title)
  .match3-presentation-fullscreen__body {
  flex: 1 1 auto;
  max-height: none;
  margin-bottom: 0;
  justify-content: stretch;
}

.match3-presentation-fullscreen__content:not(:has(.presentation-slide--team)):not(
    :has(.presentation-slide--title)
  ) {
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(56, 189, 248, 0.4) transparent;
}

.match3-presentation-fullscreen__content h2 {
  margin: 0;
  font-size: clamp(22px, 3.8vw, 32px);
  font-weight: 800;
  color: #f8fafc;
  text-shadow:
    0 0 24px rgba(56, 189, 248, 0.35),
    0 2px 8px rgba(0, 0, 0, 0.5);
}

.match3-presentation-fullscreen__title {
  min-height: clamp(44px, 7vh, 62px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 12px;
}

.match3-presentation-fullscreen__title--spacer {
  visibility: hidden;
  pointer-events: none;
}

.match3-presentation-fullscreen__body {
  flex: 1 1 auto;
  height: 100%;
  min-height: 0;
  max-height: none;
  text-align: left;
  margin-top: 1rem;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 10px;
  overflow: hidden;
}

.match3-presentation-fullscreen__body > .presentation-slide {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.match3-presentation-fullscreen__body > .presentation-slide--team {
  justify-content: stretch;
}

.match3-presentation-fullscreen__footer-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 56px;
  height: 56px;
  margin: 0;
  padding-bottom: 6px;
}

.match3-presentation-fullscreen__dots--footer {
  margin: 0;
}

.match3-presentation-fullscreen__content:not(:has(.presentation-slide--team)):not(
    :has(.presentation-slide--title)
  )
  .match3-presentation-fullscreen__body {
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(56, 189, 248, 0.4) transparent;
}

.match3-presentation-fullscreen__dots {
  margin-top: 12px;
}

.match3-presentation-fullscreen__nav {
  position: relative;
  z-index: 1;
  align-self: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  padding: 0;
  border-radius: 999px;
  border: 1px solid var(--pres-border);
  background: var(--pres-panel);
  color: #e2e8f0;
  cursor: pointer;
  overflow: visible;
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 0.8) inset,
    0 0 20px rgba(56, 189, 248, 0.12);
  transition:
    border-color 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.15s ease;
}

.match3-presentation-fullscreen__nav:hover {
  border-color: #7dd3fc;
  color: #7dd3fc;
  box-shadow: 0 0 28px rgba(56, 189, 248, 0.35);
  transform: scale(1.05);
}

.match3-presentation-fullscreen__chevron {
  display: block;
  flex-shrink: 0;
}

/* Общие панели и кнопки */

.presentation-panel {
  border-radius: 14px;
  background: var(--pres-panel);
  border: 1px solid var(--pres-border);
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 0.6) inset,
    0 12px 40px rgba(2, 6, 23, 0.55),
    0 0 32px rgba(56, 189, 248, 0.08);
}

.presentation-btn,
a.presentation-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 20px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.03em;
  cursor: pointer;
  border: 1px solid transparent;
  text-decoration: none;
  transition:
    transform 0.15s ease,
    box-shadow 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.presentation-btn:active {
  transform: scale(0.98);
}

.presentation-btn--primary {
  color: #0f172a;
  background: linear-gradient(180deg, #7dd3fc 0%, #38bdf8 55%, #0284c7 100%);
  border-color: rgba(125, 211, 252, 0.8);
  box-shadow:
    0 0 24px rgba(56, 189, 248, 0.45),
    0 4px 0 #0369a1;
}

.presentation-btn--primary:hover {
  box-shadow:
    0 0 32px rgba(56, 189, 248, 0.6),
    0 4px 0 #0369a1;
}

.presentation-btn--ghost {
  color: #bae6fd;
  background: rgba(15, 23, 42, 0.6);
  border-color: rgba(148, 163, 184, 0.4);
}

.presentation-btn--ghost:hover {
  border-color: #38bdf8;
  color: #e0f2fe;
}

.presentation-slide__actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 16px;
}

.presentation-slide__actions--center {
  margin-top: 12px;
}

.presentation-slide {
  color: #cbd5e1;
  font-size: 15px;
  line-height: 1.55;
}

.presentation-slide__note {
  margin-top: 12px !important;
  font-size: 13px;
  color: #94a3b8;
  text-align: center;
}

/* Команда — всегда в экран */

.presentation-slide--team {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.presentation-team__list {
  list-style: none;
  margin: 0;
  padding: 0;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: clamp(4px, 0.65vh, 8px);
  overflow: hidden;
}

.presentation-team__item {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  display: grid;
  grid-template-columns: clamp(36px, 4.5vh, 44px) minmax(0, 1fr);
  grid-template-rows: auto auto;
  grid-template-areas:
    'avatar main'
    'avatar tasks';
  gap: 4px calc(10px + 1rem);
  align-items: center;
  padding: clamp(6px, 1vh, 10px) 36px clamp(6px, 1vh, 10px) 10px;
  border-radius: 12px;
  background: var(--pres-panel);
  border: 1px solid rgba(148, 163, 184, 0.25);
  box-shadow: 0 6px 20px rgba(2, 6, 23, 0.35);
}

.presentation-team__backlog {
  position: absolute;
  top: 6px;
  right: 6px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.35);
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.15);
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.15s ease;
}

.presentation-team__backlog:hover {
  border-color: #7dd3fc;
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.35);
  transform: scale(1.05);
}

.presentation-team__backlog:focus-visible {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
}

.presentation-team__backlog-icon {
  display: block;
  width: 18px;
  height: 18px;
}

@media (max-height: 680px) {
  .presentation-team__item {
    grid-template-columns: clamp(32px, 4vh, 40px) minmax(0, 1fr) minmax(0, 42%);
    grid-template-rows: auto;
    grid-template-areas: 'avatar main tasks';
    align-items: center;
  }

  .presentation-team__tasks {
    justify-content: flex-end;
    flex-wrap: nowrap;
  }
}

.presentation-team__avatar-link {
  grid-area: avatar;
  align-self: center;
  display: block;
  border-radius: 50%;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.presentation-team__avatar-link:hover {
  transform: scale(1.04);
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.45);
}

.presentation-team__avatar-link:focus-visible {
  outline: 2px solid #7dd3fc;
  outline-offset: 2px;
}

.presentation-team__avatar {
  grid-area: avatar;
  align-self: center;
}

.presentation-team__avatar-link .presentation-team__avatar {
  grid-area: auto;
}

.presentation-team__avatar--lg {
  width: clamp(36px, 4.5vh, 44px);
  height: clamp(36px, 4.5vh, 44px);
  flex-shrink: 0;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
}

.presentation-team__avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  border-radius: 50%;
}

.presentation-game__qr {
  margin: 0 auto 12px;
  padding: 14px;
  border-radius: 16px;
  background: rgba(8, 16, 36, 0.75);
  border: 1px solid rgba(56, 189, 248, 0.4);
  text-align: center;
}

.presentation-game__qr img {
  display: block;
  margin: 0 auto;
  border-radius: 10px;
}

.presentation-game__qr figcaption {
  margin-top: 10px;
  font-size: 13px;
  color: #bae6fd;
}

.presentation-team__main {
  grid-area: main;
  min-width: 0;
  text-align: left;
}

.presentation-team__title {
  margin: 0;
  font-size: clamp(12px, 1.55vh, 14px);
  line-height: 1.25;
  color: #f1f5f9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.presentation-team__name {
  font-weight: 700;
}

.presentation-team__link {
  color: #e0f2fe;
  text-decoration: none;
}

.presentation-team__link:hover {
  color: #7dd3fc;
  text-decoration: underline;
}

.presentation-team__sep {
  font-weight: 400;
  color: #94a3b8;
}

.presentation-team__role {
  font-weight: 500;
  color: #cbd5e1;
}

.presentation-team__tasks {
  grid-area: tasks;
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  min-width: 0;
  align-content: flex-start;
}

.presentation-team__tag {
  max-width: 100%;
  font-size: clamp(9px, 1.2vh, 11px);
  padding: 2px 7px;
  border-radius: 999px;
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.35);
  color: #e0f2fe;
}

.presentation-team__tag-text {
  display: inline-flex;
  align-items: baseline;
  max-width: 9rem;
  overflow: hidden;
}

.presentation-team__tag-first {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  flex: 0 1 auto;
}

.presentation-team__tag-more {
  flex-shrink: 0;
  margin-left: 1px;
  opacity: 0.85;
}

/* Стек */

.presentation-stack__columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.presentation-stack__swap {
  min-height: min(48vh, 400px);
  animation: presentationStackFadeIn 0.45s ease;
}

@keyframes presentationStackFadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.presentation-stack__column {
  padding: 14px;
}

.presentation-stack__column h3 {
  margin: 0 0 10px;
  font-size: 14px;
  font-weight: 700;
  color: #7dd3fc;
  text-align: left;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.presentation-stack__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 8px;
}

.presentation-stack__list li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.55);
  border: 1px solid rgba(148, 163, 184, 0.15);
  font-size: 13px;
}

.presentation-stack__icon {
  flex-shrink: 0;
  object-fit: contain;
}

.presentation-stack__icon--placeholder {
  width: 22px;
  height: 22px;
  border-radius: 4px;
  background: rgba(148, 163, 184, 0.25);
}

.presentation-arch--http {
  margin: 0;
  padding: 12px;
}

.presentation-arch__img {
  display: block;
  width: 100%;
  max-width: min(920px, 100%);
  margin: 0 auto;
  border-radius: 10px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  box-shadow: 0 12px 32px rgba(2, 6, 23, 0.45);
}

/* Галерея блок-схем (слайд «Стек») */

.presentation-diagram-gallery {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: min(52vh, 440px);
  touch-action: pan-y;
}

.presentation-diagram-gallery__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}

.presentation-diagram-gallery__back {
  min-height: 36px;
  padding: 6px 12px;
  font-size: 13px;
}

.presentation-diagram-gallery__counter {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #bae6fd;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  background: rgba(15, 23, 42, 0.65);
}

.presentation-diagram-gallery__hint {
  margin: 0;
  font-size: 12px;
  color: #94a3b8;
  text-align: center;
}

.presentation-diagram-gallery__figure {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 10px;
}

.presentation-diagram-gallery__caption {
  margin: 0 0 8px;
  font-size: 14px;
  font-weight: 700;
  color: #e0f2fe;
  text-align: center;
}

.presentation-diagram-gallery__figure .presentation-arch__img {
  flex: 1;
  min-height: 0;
  max-height: min(42vh, 360px);
  width: auto;
  max-width: 100%;
  object-fit: contain;
}

.presentation-diagram-gallery__nav {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: stretch;
  gap: 8px;
}

.presentation-diagram-gallery__arrow {
  width: 36px;
  min-height: 36px;
  border-radius: 10px;
  border: 1px solid rgba(56, 189, 248, 0.4);
  background: rgba(15, 23, 42, 0.75);
  color: #e0f2fe;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  transition:
    border-color 0.2s ease,
    background 0.2s ease;
}

.presentation-diagram-gallery__arrow:hover {
  border-color: #7dd3fc;
  background: rgba(30, 58, 95, 0.85);
}

.presentation-diagram-gallery__tabs {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 2px 0;
  scrollbar-width: thin;
  scrollbar-color: rgba(56, 189, 248, 0.4) transparent;
  touch-action: pan-x;
}

.presentation-diagram-gallery__tab {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 34px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(15, 23, 42, 0.65);
  color: #cbd5e1;
  font-size: 11px;
  cursor: pointer;
  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    color 0.2s ease;
}

.presentation-diagram-gallery__tab--active {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.18);
  color: #f0f9ff;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
}

.presentation-diagram-gallery__tab-index {
  font-weight: 800;
  color: #7dd3fc;
}

.presentation-diagram-gallery__tab-label {
  max-width: 7rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.presentation-diagram-gallery__fullscreen-btn {
  min-height: 36px;
  padding: 6px 12px;
  font-size: 12px;
  white-space: nowrap;
}

.presentation-diagram-fullscreen {
  position: fixed;
  inset: 0;
  z-index: 1400;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px 20px 20px;
  background: rgba(2, 6, 23, 0.97);
  touch-action: pan-y;
}

.presentation-diagram-fullscreen__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.presentation-diagram-fullscreen__counter {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #bae6fd;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  background: rgba(15, 23, 42, 0.65);
}

.presentation-diagram-fullscreen__hint {
  margin: 0;
  flex: 1;
  min-width: 10rem;
  font-size: 12px;
  color: #94a3b8;
  text-align: center;
}

.presentation-diagram-fullscreen__close {
  min-height: 36px;
  padding: 6px 12px;
  font-size: 13px;
}

.presentation-diagram-fullscreen__figure {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 8px;
}

.presentation-diagram-fullscreen__caption {
  margin: 0 0 10px;
  font-size: 16px;
  font-weight: 700;
  color: #e0f2fe;
  text-align: center;
}

.presentation-diagram-fullscreen__img {
  flex: 1;
  min-height: 0;
  max-height: calc(100vh - 180px);
  max-width: min(96vw, 1400px);
  width: auto;
  object-fit: contain;
  border-radius: 10px;
  border: 1px solid rgba(56, 189, 248, 0.35);
  box-shadow: 0 16px 48px rgba(2, 6, 23, 0.55);
}

.presentation-diagram-fullscreen__nav {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: stretch;
  gap: 8px;
  flex-shrink: 0;
}

.presentation-stack__swap--diagram {
  min-height: min(56vh, 480px);
}

/* Игра — превью поля */

.presentation-slide--game {
  text-align: center;
}

.presentation-game__lead {
  margin: 0 0 20px;
  font-size: 16px;
  color: #e2e8f0;
}

.presentation-game-board {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin: 0 auto 8px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  color: inherit;
  font: inherit;
  max-width: min(320px, 100%);
  animation: presentationBoardFloat 4s ease-in-out infinite;
}

@keyframes presentationBoardFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6px);
  }
}

.presentation-game-board:focus-visible {
  outline: 2px solid #38bdf8;
  outline-offset: 6px;
  border-radius: 16px;
}

.presentation-game-board__hud {
  display: flex;
  justify-content: space-between;
  width: 100%;
  gap: 8px;
  margin-bottom: 6px;
}

.presentation-game-board__hud-pill {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #e0f2fe;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.45);
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
}

.presentation-game-board__hud-pill--score {
  color: #fde68a;
  border-color: rgba(251, 191, 36, 0.5);
}

.presentation-game-board__frame {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  padding: 10px;
  border-radius: 16px;
  background: linear-gradient(145deg, #1a2744 0%, #0b1220 100%);
  border: 2px solid rgba(56, 189, 248, 0.55);
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 0.9) inset,
    0 0 40px rgba(56, 189, 248, 0.25),
    0 16px 48px rgba(2, 6, 23, 0.6);
}

.presentation-game-board__grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(8, 1fr);
  gap: 3px;
  width: 100%;
  height: 100%;
  border-radius: 8px;
  overflow: hidden;
}

.presentation-game-board__cell {
  border-radius: 6px;
  background: radial-gradient(
    circle at 35% 28%,
    color-mix(in srgb, var(--gem-color) 90%, white),
    var(--gem-color) 55%,
    #0b1328 100%
  );
  box-shadow:
    0 0 8px color-mix(in srgb, var(--gem-color) 55%, transparent),
    0 1px 0 rgba(255, 255, 255, 0.15) inset;
  animation: presentationGemPulse 2.4s ease-in-out infinite;
  animation-delay: var(--gem-delay, 0s);
}

@keyframes presentationGemPulse {
  0%,
  100% {
    transform: scale(1);
    filter: brightness(1);
  }
  50% {
    transform: scale(0.94);
    filter: brightness(1.15);
  }
}

.presentation-game-board__shine {
  position: absolute;
  inset: 0;
  border-radius: 14px;
  pointer-events: none;
  background: linear-gradient(
    125deg,
    transparent 40%,
    rgba(255, 255, 255, 0.08) 50%,
    transparent 60%
  );
  animation: presentationBoardShine 3.5s ease-in-out infinite;
}

@keyframes presentationBoardShine {
  0%,
  100% {
    opacity: 0.3;
    transform: translateX(-30%);
  }
  50% {
    opacity: 0.7;
    transform: translateX(30%);
  }
}

.presentation-game-board__cta {
  font-size: 12px;
  font-weight: 600;
  color: #7dd3fc;
  letter-spacing: 0.04em;
}

/* Сложности */

.presentation-challenges {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}

.presentation-challenges__item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 14px;
}

.presentation-challenges__art {
  flex-shrink: 0;
  object-fit: contain;
  filter: drop-shadow(0 4px 12px rgba(167, 139, 250, 0.35));
}

.presentation-challenges__item h3 {
  margin: 0 0 6px;
  font-size: 15px;
  color: #fecaca;
}

.presentation-challenges__item p {
  margin: 0;
  font-size: 13px;
}

/* Галактика — обучение */

.presentation-slide--learning {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.presentation-galaxy {
  position: relative;
  width: 100%;
  min-height: min(42vh, 360px);
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(167, 139, 250, 0.35);
  background: radial-gradient(ellipse at 50% 50%, #1e1b4b 0%, #020617 72%);
  box-shadow:
    0 0 60px rgba(167, 139, 250, 0.15) inset,
    0 16px 48px rgba(2, 6, 23, 0.5);
}

.presentation-galaxy__sky {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.presentation-galaxy__dust {
  position: absolute;
  width: 2px;
  height: 2px;
  border-radius: 50%;
  background: #fff;
  opacity: 0.35;
  animation: presentationDustTwinkle 3s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.08s);
}

@keyframes presentationDustTwinkle {
  0%,
  100% {
    opacity: 0.2;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.4);
  }
}

.presentation-galaxy__core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32%;
  height: 32%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(
    circle at 42% 38%,
    rgba(253, 224, 171, 0.5) 0%,
    rgba(251, 191, 146, 0.22) 28%,
    rgba(125, 211, 252, 0.18) 58%,
    rgba(56, 189, 248, 0.06) 78%,
    transparent 88%
  );
  box-shadow:
    0 0 36px rgba(253, 186, 116, 0.28),
    0 0 56px rgba(125, 211, 252, 0.22);
  animation: presentationCorePulse 3s ease-in-out infinite;
}

@keyframes presentationCorePulse {
  0%,
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.9;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.08);
    opacity: 1;
  }
}

.presentation-galaxy__arm {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 90%;
  height: 42%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 1px solid rgba(167, 139, 250, 0.2);
  opacity: 0.5;
  pointer-events: none;
}

.presentation-galaxy__arm--a {
  transform: translate(-50%, -50%) rotate(-24deg);
}

.presentation-galaxy__arm--b {
  transform: translate(-50%, -50%) rotate(38deg);
  width: 75%;
  height: 32%;
}

.presentation-galaxy__planet {
  position: absolute;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  transform: translate(-50%, -50%);
  pointer-events: none;
  max-width: 88px;
}

.presentation-galaxy__planet-body {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: radial-gradient(
    circle at 32% 28%,
    #c4b5fd 0%,
    #6366f1 55%,
    #312e81 100%
  );
  box-shadow: 0 0 10px rgba(129, 140, 248, 0.45);
  opacity: 0.75;
}

.presentation-galaxy__planet-label {
  font-size: 8px;
  font-weight: 600;
  line-height: 1.15;
  text-align: center;
  color: #cbd5e1;
  opacity: 0.85;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.presentation-galaxy__planet--lit .presentation-galaxy__planet-body {
  opacity: 1;
  box-shadow: 0 0 14px rgba(167, 139, 250, 0.65);
}

.presentation-galaxy__planet--lit .presentation-galaxy__planet-label {
  color: #e0f2fe;
  opacity: 1;
}

.presentation-galaxy__star {
  position: absolute;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  transform: translate(-50%, -50%);
  color: inherit;
  font: inherit;
  max-width: 120px;
}

.presentation-galaxy__star-glow {
  position: absolute;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(125, 211, 252, 0.5), transparent 70%);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.presentation-galaxy__star-core {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #fff, #7dd3fc 45%, #2563eb 100%);
  box-shadow: 0 0 16px rgba(125, 211, 252, 0.8);
  animation: presentationStarPulse 2.2s ease-in-out infinite;
}

@keyframes presentationStarPulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.15);
  }
}

.presentation-galaxy__star-label {
  position: relative;
  z-index: 1;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #e0f2fe;
  text-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
  white-space: nowrap;
}

.presentation-galaxy__star--active .presentation-galaxy__star-glow,
.presentation-galaxy__star:hover .presentation-galaxy__star-glow {
  opacity: 1;
}

.presentation-galaxy__star--active .presentation-galaxy__star-core {
  width: 18px;
  height: 18px;
  box-shadow: 0 0 24px rgba(167, 139, 250, 0.9);
}

.presentation-galaxy__finale {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.presentation-galaxy__thanks {
  margin: 0;
  font-size: clamp(18px, 4vw, 28px);
  font-weight: 900;
  letter-spacing: 0.2em;
  color: #f0f9ff;
  text-shadow:
    0 0 14px rgba(253, 186, 116, 0.45),
    0 0 28px rgba(125, 211, 252, 0.55);
}

.presentation-galaxy__qr {
  margin: 0;
  padding: 8px;
  border-radius: 14px;
  background: rgba(8, 16, 36, 0.75);
  border: 1px solid rgba(125, 211, 252, 0.45);
  box-shadow:
    0 0 20px rgba(56, 189, 248, 0.2),
    inset 0 0 12px rgba(253, 186, 116, 0.08);
  pointer-events: auto;
}

.presentation-galaxy__qr img {
  display: block;
  width: clamp(64px, 10vh, 88px);
  height: auto;
  border-radius: 8px;
}

.presentation-galaxy__qr-caption {
  margin-top: 6px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: center;
  color: #bae6fd;
}

.presentation-galaxy__detail {
  padding: 14px 18px;
  text-align: center;
}

.presentation-galaxy__detail p {
  margin: 0 0 10px;
  font-size: 14px;
  line-height: 1.55;
  color: #e2e8f0;
}

.presentation-galaxy__detail-planets {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
}

.presentation-galaxy__detail-planets li {
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(99, 102, 241, 0.2);
  border: 1px solid rgba(167, 139, 250, 0.45);
  color: #e0e7ff;
}

/* Титульный слайд (hero лендинга) */

.match3-presentation-fullscreen .presentation-slide--title.hero {
  flex: 1;
  min-height: 0;
  margin: 0;
  max-width: none;
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  gap: clamp(16px, 3vw, 32px);
  align-items: center;
  text-align: left;
}

.presentation-title__brand {
  --presentation-title-logo-size: 50px;
  --presentation-title-logo-gap: 14px;
  display: flex;
  align-items: center;
  gap: var(--presentation-title-logo-gap);
  margin-bottom: 12px;
  padding-left: 6px;
  overflow: visible;
}

.presentation-title__copy {
  margin-left: calc(
    6px + var(--presentation-title-logo-size) + var(--presentation-title-logo-gap)
  );
  max-width: 520px;
}

.presentation-title__copy p {
  margin: 0 0 16px;
}

.presentation-title__logo {
  flex-shrink: 0;
  margin-left: 4px;
  border-radius: 50%;
  box-shadow:
    0 0 24px rgba(79, 70, 229, 0.55),
    0 0 0 1px rgba(148, 163, 184, 0.45);
}

.match3-presentation-fullscreen .presentation-slide--title .hero__text h1 {
  margin: 0;
  font-size: clamp(22px, 3.2vh, 34px);
  line-height: 1.15;
  color: #f8fafc;
}

.match3-presentation-fullscreen .presentation-slide--title .presentation-title__copy p {
  color: #cbd5e1;
}

.match3-presentation-fullscreen .presentation-slide--title .hero-board {
  background: rgba(8, 16, 36, 0.65);
  border-color: rgba(56, 189, 248, 0.35);
}

.presentation-slide--diagrams {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.presentation-diagram-gallery__toolbar--embedded {
  justify-content: space-between;
}

.presentation-diagram-gallery__pdf-note {
  margin: 8px 0 0;
  font-size: 11px;
  text-align: center;
  color: #94a3b8;
}

/* PDF export */

.match3-presentation-fullscreen__topbar-actions {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.match3-presentation-fullscreen__pdf {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--pres-topbar-control-height, 40px);
  padding: 8px 12px;
  border-radius: 10px;
  border: 1px solid var(--pres-border);
  background: var(--pres-panel);
  color: #e2e8f0;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.12);
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.match3-presentation-fullscreen__pdf:hover:not(:disabled) {
  border-color: #7dd3fc;
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
}

.match3-presentation-fullscreen__pdf:disabled {
  opacity: 0.65;
  cursor: wait;
}

.match3-presentation-fullscreen__pdf-error {
  position: absolute;
  top: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4;
  margin: 0;
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 12px;
  color: #fecaca;
  background: rgba(127, 29, 29, 0.85);
  border: 1px solid rgba(248, 113, 113, 0.5);
}

.presentation-pdf-export-host {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
  pointer-events: none;
}

.presentation-pdf-page {
  width: 1280px;
  height: 720px;
  box-sizing: border-box;
  padding: 36px 48px 0;
  display: flex;
  flex-direction: column;
  color: #e2e8f0;
  background-color: #020617;
  background-image:
    linear-gradient(
      165deg,
      rgba(8, 16, 36, 0.72) 0%,
      rgba(2, 6, 23, 0.82) 45%,
      rgba(15, 23, 42, 0.78) 100%
    ),
    var(--pres-bg-url, none);
  background-size: cover;
  background-position: center;
}

.presentation-pdf-page__title {
  flex-shrink: 0;
  margin: 0 0 12px;
  font-size: 28px;
  font-weight: 800;
  color: #f0f9ff;
  text-align: center;
  letter-spacing: 0.02em;
}

.presentation-pdf-page__shell {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.presentation-pdf-page__body {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 100%;
}

.presentation-pdf-page__body > * {
  width: 100%;
  max-height: 100%;
}

.presentation-pdf-page--title .presentation-pdf-page__body {
  align-items: center;
}

.presentation-pdf-page__footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 8px;
  padding: 10px 0 18px;
  border-top: 1px solid rgba(148, 163, 184, 0.22);
  font-size: 12px;
  font-weight: 600;
  color: #94a3b8;
  letter-spacing: 0.03em;
}

.presentation-pdf-page__footer-right {
  color: #bae6fd;
}

.presentation-pdf-page .presentation-slide--title.hero {
  height: auto;
  max-height: 100%;
}

/* PDF: слайд команды без сплющивания */
.presentation-pdf-page .presentation-slide--team {
  flex: 0 1 auto;
  height: auto;
  max-height: 100%;
  justify-content: center;
}

.presentation-pdf-page .presentation-team__list {
  flex: 0 1 auto;
  justify-content: center;
  gap: 10px;
  max-height: 100%;
}

.presentation-pdf-page .presentation-team__item {
  flex: 0 0 auto;
  min-height: 76px;
}

.presentation-pdf-page .presentation-slide--stack,
.presentation-pdf-page .presentation-slide--diagrams,
.presentation-pdf-page .presentation-slide--game,
.presentation-pdf-page .presentation-slide--challenges,
.presentation-pdf-page .presentation-slide--learning {
  flex: 0 1 auto;
  max-height: 100%;
  justify-content: center;
}

/* Адаптив */

@media (max-width: 720px) {
  .match3-presentation-fullscreen {
    grid-template-columns: 1fr;
    padding-bottom: 12px;
  }

  .match3-presentation-fullscreen__content {
    grid-column: 1;
    padding-top: 64px;
  }

  .match3-presentation-fullscreen--compact-nav
    .match3-presentation-fullscreen__topbar {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto;
    align-items: center;
    justify-items: stretch;
  }

  .match3-presentation-fullscreen--compact-nav
    .match3-presentation-fullscreen__counter {
    grid-column: 1;
    grid-row: auto;
    max-width: min(52vw, 320px);
  }

  .match3-presentation-fullscreen--compact-nav
    .match3-presentation-fullscreen__header-nav {
    grid-column: 2;
    grid-row: auto;
    position: static;
    left: auto;
    top: auto;
    bottom: auto;
    transform: none;
    width: auto;
    justify-self: center;
  }

  .match3-presentation-fullscreen--compact-nav
    .match3-presentation-fullscreen__close {
    grid-column: 3;
    grid-row: auto;
    justify-self: end;
  }

  .presentation-stack__columns {
    grid-template-columns: 1fr;
  }

  .presentation-galaxy {
    min-height: 280px;
  }

  .presentation-galaxy__star-label {
    font-size: 10px;
  }

  .presentation-game-board {
    max-width: 100%;
  }

  .presentation-diagram-gallery__nav {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
  }

  .presentation-diagram-gallery__arrow {
    display: none;
  }

  .presentation-diagram-gallery__tabs {
    order: -1;
  }
}

@media (max-width: 640px) {
  .match3-presentation-fullscreen--compact-nav
    .match3-presentation-fullscreen__header-nav
    .match3-presentation__dot {
    display: none;
  }

  .match3-presentation-fullscreen--compact-nav
    .match3-presentation-fullscreen__header-nav
    .match3-presentation-fullscreen__nav {
    border: none;
    background: transparent;
    box-shadow: none;
  }
}

@media (max-width: 999px) {
  .match3-presentation-fullscreen__close {
    width: var(--pres-topbar-control-height);
    padding: 0;
    gap: 0;
  }

  .match3-presentation-fullscreen__close-label {
    display: none;
  }

  .match3-presentation-fullscreen__close-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transform: rotate(45deg) translateY(-0.5px);
  }
}

@media (max-width: 480px) {
  .presentation-galaxy__thanks {
    font-size: 16px;
    letter-spacing: 0.12em;
  }

  .match3-presentation-fullscreen .presentation-slide--title.hero {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .presentation-title__brand {
    flex-direction: column;
    text-align: center;
  }

  .match3-presentation-fullscreen__topbar-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .match3-presentation-fullscreen__pdf {
    padding: 6px 10px;
    font-size: 12px;
  }

  .presentation-team__item {
    grid-template-columns: 36px 1fr;
    grid-template-areas:
      'avatar main'
      'avatar tasks';
  }

  .presentation-team__title {
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .presentation-galaxy__planet-label {
    font-size: 7px;
    max-width: 64px;
  }
}

/* Портрет: контент не обрезается (iPhone и узкие экраны) */
@media (max-width: 430px), (max-height: 860px) {
  .match3-presentation-fullscreen {
    min-height: 100dvh;
    height: auto;
    max-height: 100dvh;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .match3-presentation-fullscreen__content {
    overflow-x: hidden;
    overflow-y: visible;
    height: auto;
    min-height: 0;
    max-height: none;
    justify-content: flex-start;
    padding-top: max(48px, env(safe-area-inset-top, 0px));
    padding-bottom: max(12px, env(safe-area-inset-bottom, 0px));
  }

  .match3-presentation-fullscreen__content-inner {
    grid-template-rows: auto auto auto;
    height: auto;
    max-height: none;
  }

  .match3-presentation-fullscreen__body {
    overflow: visible;
    flex: 0 1 auto;
    min-height: 0;
    max-height: none;
    margin-top: 0.5rem;
  }

  .match3-presentation-fullscreen__body > .presentation-slide {
    flex: 0 1 auto;
    min-height: 0;
    justify-content: flex-start;
  }
}

/* Альбом: слайды не сплющивать, прокрутка тела */
@media (orientation: landscape) and (max-height: 520px) {
  .match3-presentation-fullscreen {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .match3-presentation-fullscreen__content {
    overflow-y: visible;
    justify-content: flex-start;
    padding-top: max(40px, env(safe-area-inset-top, 0px));
  }

  .match3-presentation-fullscreen__content-inner {
    grid-template-rows: auto minmax(min-content, auto) auto;
    height: auto;
  }

  .match3-presentation-fullscreen__body {
    overflow: visible;
    flex: 0 1 auto;
    min-height: min-content;
  }

  .match3-presentation-fullscreen__body > .presentation-slide {
    flex: 0 1 auto;
    min-height: min-content;
  }

  .match3-presentation-fullscreen .presentation-slide--title.hero {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 12px;
    align-items: center;
  }

  .match3-presentation-fullscreen .presentation-slide--title .presentation-title__copy p {
    font-size: clamp(12px, 2.2vh, 15px);
    margin-bottom: 10px;
  }

  .presentation-team__list {
    gap: 8px;
  }

  .presentation-team__item {
    padding: 8px 10px;
  }
}
